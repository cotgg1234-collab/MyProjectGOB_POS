generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("user")
  shopName     String?  @unique
  shopCode     String?  @unique
  ownerId      Int?
  owner        User?    @relation("ShopMembers", fields: [ownerId], references: [id], onDelete: SetNull)
  staff        User[]   @relation("ShopMembers")
  createdAt    DateTime @default(now())
  sales        Sale[]
  categories   Category[]
  products     Product[]
  shopSales    Sale[]     @relation("ShopSales")

  @@index([ownerId])
}

model Category {
  id       Int       @id @default(autoincrement())
  ownerId  Int
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name     String
  nameEn   String?
  products Product[]

  @@unique([ownerId, name])
}

model Product {
  id         Int        @id @default(autoincrement())
  ownerId    Int
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  nameEn     String?
  price      Float
  cost       Float      @default(0)
  stock      Int        @default(0)
  lowStock   Int        @default(5)
  imageUrl   String?
  active     Boolean    @default(true)
  categoryId Int?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items      SaleItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([ownerId, sku])
  @@index([categoryId])
}

model Sale {
  id        Int        @id @default(autoincrement())
  ownerId   Int
  shop      User       @relation("ShopSales", fields: [ownerId], references: [id], onDelete: Cascade)
  code      String
  saleDate  DateTime   @default(now())
  subtotal  Float
  discount  Float      @default(0)
  tax       Float      @default(0)
  total     Float
  cost      Float      @default(0)
  received  Float      @default(0)
  change    Float      @default(0)
  payMethod String     @default("cash")
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@unique([ownerId, code])
  @@index([saleDate])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku       String  @default("")
  name      String
  qty       Int
  unitPrice Float
  unitCost  Float   @default(0)
  lineTotal Float

  @@index([saleId])
  @@index([productId])
}
